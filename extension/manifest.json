{
  "manifest_version": 3,
  "name": "Timebit",
  "version": "0.4.0",
  "description": "Study with Pomodoro, Cascade, or a finish-by plan and block distractions during focus time.",
  "minimum_chrome_version": "127",
  "permissions": ["storage", "alarms", "notifications", "offscreen", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    { "resources": ["redirect/index.html"], "matches": ["*://*/*"] }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Timebit",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
